<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>工具導覽</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", sans-serif;
    color: #f0e6c8;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    position: relative;
    overflow-x: hidden;
    background: #0a0805;
  }

  /* ===== 1. 暗金底 + 中央金光護體光暈 ===== */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -4;
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 200, 80, 0.20), transparent 55%),
      radial-gradient(circle at 50% 50%, rgba(180, 120, 20, 0.18), transparent 70%),
      linear-gradient(165deg, #0d0a04 0%, #14100a 45%, #0a0805 100%);
  }

  /* ===== 2. 金光神咒經文浮水印（直書鋪滿） ===== */
  .mantra {
    position: fixed;
    inset: -10%;
    z-index: -3;
    display: flex;
    flex-direction: row-reverse;
    justify-content: center;
    gap: 2.2rem;
    opacity: 0.13;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 20%, transparent 78%);
    mask-image: radial-gradient(circle at 50% 50%, #000 20%, transparent 78%);
    animation: glowPulse 9s ease-in-out infinite;
  }

  .mantra span {
    writing-mode: vertical-rl;
    font-family: "Noto Serif TC", "Songti TC", "STSong", serif;
    font-size: clamp(0.9rem, 1.6vw, 1.35rem);
    line-height: 1.5;
    letter-spacing: 0.35em;
    color: #d9b45a;
    text-shadow: 0 0 10px rgba(255, 190, 60, 0.6);
    white-space: nowrap;
  }

  @keyframes glowPulse {
    0%, 100% { opacity: 0.09; }
    50%      { opacity: 0.18; }
  }

  /* ===== 3. 符籙金線斜掃 ===== */
  .goldline {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      linear-gradient(115deg, transparent 44%, rgba(255, 210, 90, 0.10) 48%, rgba(255, 235, 170, 0.20) 50%, rgba(255, 210, 90, 0.10) 52%, transparent 56%);
    animation: sweep 9s ease-in-out infinite;
  }

  @keyframes sweep {
    0%, 100% { transform: translateX(-10%); opacity: 0.45; }
    50%      { transform: translateX(10%);  opacity: 1; }
  }

  /* ===== 4. 金色粒子 ===== */
  .sparks { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .sparks i {
    position: absolute;
    bottom: -10px;
    width: 3px; height: 3px;
    border-radius: 50%;
    background: #ffd86b;
    box-shadow: 0 0 8px 2px rgba(255, 200, 70, 0.8);
    animation: rise linear infinite;
  }
  @keyframes rise {
    0%   { transform: translateY(0) scale(1);   opacity: 0; }
    15%  { opacity: 0.9; }
    100% { transform: translateY(-100vh) scale(0.4); opacity: 0; }
  }

  /* ===== 標題 ===== */
  h1 {
    font-family: "Noto Serif TC", "Songti TC", serif;
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-align: center;
    margin-bottom: 10px;
    color: #ffe9a8;
    text-shadow:
      0 0 14px rgba(255, 200, 70, 0.8),
      0 0 36px rgba(220, 150, 20, 0.5),
      0 0 70px rgba(180, 110, 0, 0.35);
  }

  .subtitle {
    font-size: 0.76rem;
    letter-spacing: 0.35em;
    color: #b08a3a;
    margin-bottom: 46px;
    text-align: center;
    text-shadow: 0 0 10px rgba(255, 190, 60, 0.35);
  }

  /* ===== 卡片 ===== */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
    max-width: 780px;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .card {
    display: block;
    text-decoration: none;
    background: rgba(18, 14, 6, 0.76);
    border: 1px solid rgba(214, 178, 90, 0.32);
    border-radius: 14px;
    padding: 24px 22px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(6px);
  }

  .card::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 3px; height: 100%;
    background: linear-gradient(180deg, #ffe08a, #b8862a);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card:hover {
    background: rgba(30, 24, 10, 0.92);
    border-color: rgba(255, 210, 100, 0.75);
    transform: translateY(-3px);
    box-shadow:
      0 8px 30px rgba(0, 0, 0, 0.55),
      0 0 28px rgba(255, 190, 60, 0.35);
  }

  .card:hover::before { opacity: 1; }

  .card .icon {
    font-size: 1.6rem;
    margin-bottom: 10px;
    display: block;
    filter: drop-shadow(0 0 8px rgba(255, 200, 70, 0.6));
  }

  .card .title {
    font-family: "Noto Serif TC", "Songti TC", serif;
    font-size: 1.08rem;
    font-weight: 700;
    color: #f5e2b0;
    margin-bottom: 6px;
    letter-spacing: 0.08em;
  }

  .card .desc {
    font-size: 0.82rem;
    color: #9c8d6c;
    line-height: 1.55;
  }

  .card .url {
    font-size: 0.7rem;
    color: #6b5f45;
    margin-top: 12px;
    word-break: break-all;
    font-family: monospace;
  }
</style>
</head>
